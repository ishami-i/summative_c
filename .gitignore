*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Common CMake / Make / Build folders (anywhere in repo)
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile.in

